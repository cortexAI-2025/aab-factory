# Server
PORT=3000
NODE_ENV=development

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# OR use a service account key file (do NOT commit this file)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# AI Engine — use one of:
OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=...
AI_PROVIDER=openai  # "openai" | "mistral"

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...       # Monthly Pro subscription price ID
STRIPE_BUILD_PACK_PRICE_ID=price_... # One-time 5-build pack price ID

# Build System
BUILD_WORKER_CONCURRENCY=3          # Max parallel builds
ANDROID_HOME=/usr/local/android-sdk
GRADLE_HOME=/usr/local/gradle
KEYSTORE_PATH=/secure/keystore/system.jks
KEYSTORE_PASSWORD=changeme
KEY_ALIAS=aabfactory
KEY_PASSWORD=changeme

# App
APP_BASE_URL=https://api.aabfactory.com
FRONTEND_URL=aabfactory://payment
