# Server
PORT=3000
NODE_ENV=development

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# OR use a service account key file (do NOT commit this file)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# AI Engine — use one of:
OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=...
AI_PROVIDER=openai  # "openai" | "mistral"

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...       # Monthly Pro subscription price ID
STRIPE_BUILD_PACK_PRICE_ID=price_... # One-time 5-build pack price ID

# Build System
BUILD_WORKER_CONCURRENCY=1          # Current service permits one active build per API process
ANDROID_HOME=/usr/local/android-sdk
GRADLE_HOME=/usr/local/gradle
# Path to a cached gradle-wrapper.jar on the build server (required by the build worker)
# Download once: https://services.gradle.org/distributions/gradle-8.6-bin.zip
# Generate a real wrapper with the reviewed Gradle distribution: gradle wrapper
# Copy gradle/wrapper/gradle-wrapper.jar; the launcher jar is NOT a wrapper jar.
GRADLE_WRAPPER_JAR_PATH=/opt/gradle-wrapper.jar
KEYSTORE_PATH=/secure/keystore/system.jks
KEYSTORE_PASSWORD=changeme
KEY_ALIAS=aabfactory
KEY_PASSWORD=changeme

# App
APP_BASE_URL=https://api.aabfactory.com
FRONTEND_URL=aabfactory://payment

# Explicit owner authorization; disabled by default.
SIGNING_AUTHORIZED=false
# Reviewed image digest with SDK/JDK and offline Gradle/Maven caches.
AAB_BUILDER_IMAGE=
AAB_WORKSPACE_DIR=/tmp/aab-builds
# Reviewed bundletool on signing host, outside the untrusted container.
BUNDLETOOL_JAR=
